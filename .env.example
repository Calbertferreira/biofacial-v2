DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@unpooled-host/database?sslmode=verify-full
PORT=3001
# Configure quando o aplicativo de convites estiver publicado.
PUBLIC_BASE_URL=http://localhost:3002
RESEND_API_KEY=
INVITATION_EMAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_VERSION=v23.0
# Apenas para BROWSER_DEMO=true, nunca em implantação pública
ADMIN_API_KEY=replace-with-a-long-random-secret
# Omitir no teste apenas do Manager. Sem essas variáveis, o scanner e a biometria ficam indisponíveis.
SCANNER_API_KEY=replace-with-a-separate-long-random-secret
FACE_ENGINE_URL=http://localhost:8000
FACE_ENGINE_TOKEN=replace-with-another-long-random-secret
FACE_TEMPLATE_KEY=replace-with-a-fernet-key-for-the-face-engine-only
